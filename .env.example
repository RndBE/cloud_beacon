APP_NAME="Cloud Beacon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

DB2_HOST=127.0.0.1
DB2_PORT=3306
DB2_DATABASE=
DB2_USERNAME=root
DB2_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_PREFIX=cloud_beacon_
MQTT_TIMEOUT=15
MQTT_FTP_TIMEOUT=120

MINISTESY_ENDPOINT=

SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_PATH=
SSH_MQTT_SERVICE=

CLOUD_SSH_BRIDGE_SECRET=
CLOUD_SSH_WS_PATH=/cloud-ssh/ws
CLOUD_SSH_TOKEN_TTL=30

CLOUD_WEB_BASE_DOMAIN=be-stesy.cloud
CLOUD_WEB_BRIDGE_SECRET=
CLOUD_WEB_TOKEN_TTL=30
CLOUD_WEB_ALLOWED_CIDR=10.8.0.0/24

BACKFILL_INTERVAL=10
BACKFILL_ACK_TIMEOUT=10
BACKFILL_CONFIRM_TIMEOUT=15
BACKFILL_MAX_ATTEMPTS=3
BACKFILL_QUEUE=backfill

RESEND_ETA_INTERVAL=2
RESEND_STALE_AFTER=300
