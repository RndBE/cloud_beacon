BRIDGE_PORT=8391
BIND_HOST=127.0.0.1
# URL internal Laravel (bukan URL publik) untuk menukar token.
LARAVEL_INTERNAL_URL=https://be-stesy.cloud
# Harus sama dengan CLOUD_SSH_BRIDGE_SECRET di .env Laravel.
BRIDGE_SECRET=
# Private key milik server untuk SSH ke perangkat (pubkey ditanam di perangkat).
SSH_PRIVATE_KEY_PATH=/root/.ssh/cloud_beacon_bridge
