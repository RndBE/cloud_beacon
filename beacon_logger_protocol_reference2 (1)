      "name_sensor": "FlowMeter",
      "sensor_type": "Debit_Air",
      "baudrate": 19200,
      "format": "8E1",
      "value": 3.540,
      "unit": "L/s"
    },
    {
      "nama_protocol": "RS232",
      "name_sensor": "RainGauge",
      "port": 1,
      "sensor_type": "RainGauge",
      "value": 12.300,
      "unit": "mm"
    },
    {
      "nama_protocol": "ANALOG",
      "name_sensor": "WaterLevel",
      "channel": 0,
      "sensor_type": "WaterLevel",
      "value": 45.20000,
      "unit": "cm"
    },
    {
      "nama_protocol": "DIGITAL",
      "name_sensor": "Door",
      "channel": 0,
      "mode": 0,
      "value": 1.000,
      "unit": ""
    }
  ]
